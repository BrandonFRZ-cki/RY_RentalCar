<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane stylesheets="@styles.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ups.bdd.ry_rental_car.ry_rentalcar.controllers.EmpleadosController">

    <HBox spacing="45" AnchorPane.leftAnchor="65" AnchorPane.rightAnchor="65" AnchorPane.topAnchor="45">

        <VBox prefHeight="545" prefWidth="470" spacing="20" styleClass="table-card">

            <HBox spacing="15">
                <TextField fx:id="txtBuscar" prefHeight="40" prefWidth="330" promptText="Buscar Empleados" styleClass="search-input" />

                <Button prefHeight="40" prefWidth="80" styleClass="btn-dark" text="Buscar" />
            </HBox>

            <TableView fx:id="tblEmpleados" prefHeight="315" prefWidth="440">
                <columns>
                    <TableColumn fx:id="colIdentificacion" prefWidth="85" text="Cédula" />
                    <TableColumn fx:id="colNombre" prefWidth="110" text="Nombre" />
                    <TableColumn fx:id="colTelefono" prefWidth="85" text="Teléfono" />
                    <TableColumn fx:id="colRol" prefWidth="85" text="Rol" />
                    <TableColumn fx:id="colEstado" prefWidth="75" text="Estado" />
                </columns>
            </TableView>

        </VBox>

        <VBox prefHeight="545" prefWidth="430" spacing="7" styleClass="form-card">

            <Label styleClass="form-title" text="Datos del Empleado" />

            <HBox spacing="25">
                <VBox spacing="5">
                    <Label styleClass="field-label" text="Identificación:" />
                    <TextField fx:id="txtIdentificacion" prefHeight="32" prefWidth="170" />
                </VBox>

                <VBox spacing="5">
                    <Label styleClass="field-label" text="Teléfono:" />
                    <TextField fx:id="txtTelefono" prefHeight="32" prefWidth="170" />
                </VBox>
            </HBox>

            <Label styleClass="field-label" text="Nombres:" />
            <TextField fx:id="txtNombres" prefHeight="32" />

            <Label styleClass="field-label" text="Apellidos:" />
            <TextField fx:id="txtApellidos" prefHeight="32" />

            <Label styleClass="field-label" text="Dirección:" />
            <TextField fx:id="txtDireccion" prefHeight="32" />

            <Label styleClass="field-label" text="Correo:" />
            <TextField fx:id="txtCorreo" prefHeight="32" />

            <HBox spacing="25">
                <VBox spacing="5">
                    <Label styleClass="field-label" text="Rol:" />
                    <ComboBox fx:id="cmbRol" prefHeight="32" prefWidth="170" />
                </VBox>

            </HBox>

            <Label fx:id="lblMensaje" styleClass="error-text" />

            <HBox alignment="CENTER" spacing="15">
                <Button onAction="#guardarEmpleado" prefWidth="130" styleClass="btn-dark" text="Guardar" />

                <Button onAction="#actualizarEmpleado" prefWidth="130" styleClass="btn-dark" text="Actualizar" />
            </HBox>

            <HBox alignment="CENTER" spacing="15">
                <Button onAction="#desactivarEmpleado" prefWidth="145" styleClass="btn-danger" text="Desactivar" />
                <Button onAction="#activarEmpleado" prefWidth="145" styleClass="btn-dark" text="Activar" />
            </HBox>
         <Label text="Crear usuario para este empleado (solo rol Atención al Cliente)" />

            <Label styleClass="field-label" text="Nombre de usuario:" />
            <TextField fx:id="txtNombreUsuario" prefHeight="32" prefWidth="260" />

            <Label styleClass="field-label" text="Contraseña:" />
            <PasswordField fx:id="txtContraseniaUsuario" prefHeight="32" prefWidth="260" />

            <Label styleClass="field-label" text="Permiso:" />
            <ComboBox fx:id="cmbPermiso" prefHeight="32" prefWidth="260" />
            <!-- En el controller puedes llenarlo así en initialize():
                 cmbPermiso.setItems(FXCollections.observableArrayList("ADMINISTRADOR", "GENERAL")); -->

            <Label fx:id="lblMensajeUsuario" styleClass="error-text" />

            <Button onAction="#crearUsuarioParaEmpleado" prefWidth="160" styleClass="btn-dark" text="Crear usuario" />
        </VBox>

    </HBox>

</AnchorPane>
