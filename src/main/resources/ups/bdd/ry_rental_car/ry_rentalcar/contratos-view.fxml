<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane stylesheets="@styles.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ups.bdd.ry_rental_car.ry_rentalcar.controllers.ContratosController">

    <HBox spacing="40" AnchorPane.leftAnchor="45" AnchorPane.rightAnchor="45" AnchorPane.topAnchor="35">

        <VBox prefHeight="600" prefWidth="430" spacing="15" styleClass="table-card">

            <HBox spacing="15">
                <TextField fx:id="txtBuscar" prefHeight="40" prefWidth="300" promptText="Buscar Contratos" styleClass="search-input" />
                <Button prefHeight="40" prefWidth="80" styleClass="btn-dark" text="Buscar" />
            </HBox>

            <TableView fx:id="tblContratos" prefHeight="280" prefWidth="400">
                <columns>
                    <TableColumn fx:id="colNumero" prefWidth="80" text="Número" />
                    <TableColumn fx:id="colCliente" prefWidth="95" text="Cliente" />
                    <TableColumn fx:id="colVehiculo" prefWidth="105" text="Vehículo" />
                    <TableColumn fx:id="colTotal" prefWidth="65" text="Total" />
                    <TableColumn fx:id="colEstado" prefWidth="65" text="Estado" />
                </columns>
            </TableView>

            <!-- Detalle de servicios adicionales, como una factura -->
            <Label styleClass="form-title" text="Servicios adicionales del contrato" />
         <VBox prefHeight="97.0" prefWidth="398.0">
            <children>
      
                  <HBox prefHeight="32.0" prefWidth="367.0" spacing="10">
                      <ComboBox fx:id="cmbServicio" prefHeight="32" prefWidth="199.0" promptText="Servicio" />
                      <TextField fx:id="txtCantidadServicio" prefHeight="32" prefWidth="83.0" promptText="Cant." />
                  </HBox>
            </children>
         </VBox>
             <Button onAction="#agregarServicioAlDetalle" prefHeight="33.0" prefWidth="395.0" styleClass="btn-dark" text="Agregar" />
             <Button onAction="#quitarServicioDelDetalle" prefHeight="33.0" prefWidth="402.0" styleClass="btn-danger" text="Quitar" />

            <TableView fx:id="tblDetalleServicios" prefHeight="150" prefWidth="400">
                <columns>
                    <TableColumn fx:id="colServicio" prefWidth="180" text="Servicio" />
                    <TableColumn fx:id="colCantidad" prefWidth="70" text="Cant." />
                    <TableColumn fx:id="colTotalLinea" prefWidth="100" text="Total línea" />
                </columns>
            </TableView>

        </VBox>

        <VBox prefHeight="600" prefWidth="430" spacing="7" styleClass="form-card">

            <Label styleClass="form-title" text="Datos del Contrato" />

            <Label styleClass="field-label" text="Cédula del cliente:" />
            <TextField fx:id="txtBuscarCedula" prefHeight="32" prefWidth="300" promptText="0100000001" />

            <Label styleClass="field-label" text="Reserva activa del cliente:" />
            <ComboBox fx:id="cmbReserva" prefHeight="32" prefWidth="310" />

            <Label styleClass="field-label" text="Usuario:" />
            <Label fx:id="lblUsuarioActual" styleClass="field-label" />

            <HBox spacing="25">
                <VBox spacing="5">
                    <Label styleClass="field-label" text="Fecha inicio:" />
                    <TextField fx:id="txtFechaInicio" editable="false" prefHeight="32" prefWidth="155" />
                </VBox>
                <VBox spacing="5">
                    <Label styleClass="field-label" text="Fecha fin:" />
                    <TextField fx:id="txtFechaFin" editable="false" prefHeight="32" prefWidth="155" />
                </VBox>
            </HBox>

            <HBox spacing="25">
                <VBox spacing="5">
                    <Label styleClass="field-label" text="Precio diario:" />
                    <TextField fx:id="txtPrecioDiario" editable="false" prefHeight="32" prefWidth="155" />
                </VBox>
                <VBox spacing="5">
                    <Label styleClass="field-label" text="Subtotal (renta+servicios):" />
                    <TextField fx:id="txtSubtotal" editable="false" prefHeight="32" prefWidth="155" />
                </VBox>
            </HBox>

            <HBox spacing="25">
                <VBox spacing="5">
                    <Label styleClass="field-label" text="IVA:" />
                    <TextField fx:id="txtIva" editable="false" prefHeight="32" prefWidth="155" />
                </VBox>
                <VBox spacing="5">
                    <Label styleClass="field-label" text="Total:" />
                    <TextField fx:id="txtTotal" editable="false" prefHeight="32" prefWidth="155" />
                </VBox>
            </HBox>

            <Label fx:id="lblMensaje" styleClass="error-text" />

            <HBox alignment="CENTER" spacing="12">
                <Button onAction="#generarContrato" prefWidth="140" styleClass="btn-dark" text="Generar" />
            </HBox>

            <HBox alignment="CENTER">
                <Button onAction="#anularContrato" prefWidth="180" styleClass="btn-danger" text="Anular Contrato" />
            </HBox>

        </VBox>

    </HBox>

</AnchorPane>
